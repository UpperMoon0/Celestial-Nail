+  sodium-extras-compat:
+    name: Sodium Extras optional compatibility (Forge 1.20.1)
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '21'
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - uses: gradle/actions/setup-gradle@v4
+      - run: chmod +x gradlew
+      - name: Check out Perfomant Boom API dependency
+        uses: actions/checkout@v4
+        with:
+          repository: UpperMoon0/Perfomant-Boom
+          ref: ${{ vars.PERFOMANT_BOOM_REF || 'main' }}
+          path: .dependencies/perfomant-boom
+          persist-credentials: false
+      - name: Build matching Perfomant Boom artifacts
+        working-directory: .dependencies/perfomant-boom
+        run: bash gradlew :common:publishToMavenLocal :fabric:publishToMavenLocal :forge:publishToMavenLocal --no-daemon --max-workers=2
+      - name: Install virtual display and OpenGL runtime
+        run: sudo apt-get update && sudo apt-get install -y xvfb libgl1-mesa-dri libopenal1
+      - name: Test real dispatcher with Sodium Extras absent and present
+        env:
+          LIBGL_ALWAYS_SOFTWARE: '1'
+          ALSOFT_DRIVERS: 'null'
+        run: xvfb-run -a -s '-screen 0 1280x720x24' python tools/run_sodium_extras_compat.py
+      - name: Upload compatibility evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: sodium-extras-compat-evidence
+          path: |
+            build/reports/sodium-extras-compat/
+            forge-1.20.1/run/sodium-extras-compat/logs/
+            forge-1.20.1/run/sodium-extras-compat/sodium-extras-compat-results.json
+          if-no-files-found: warn
+
   build-1201:
